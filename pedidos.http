@baseUrl = http://localhost:8000

# Este archivo crea sus propios productos y guarda los ids que devuelve
# la API (con "# @name"), funcionando de forma dinámica e independiente.
# Ejecutar las peticiones en orden, de arriba hacia abajo.

### 1. Preparación: crear producto Pizza Especial - 201
# @name pizza
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Pizza Especial Jamón y Morrón",
  "descripcion": "Muzzarella, jamón cocido y morrones asados",
  "precio_base": 9500,
  "imagenes_url": [],
  "disponible": true
}

### 2. Preparación: crear producto Cerveza Artesanal - 201
# @name cerveza
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Cerveza IPA 500ml",
  "descripcion": "Cerveza artesanal rubia lupulada",
  "precio_base": 3200,
  "imagenes_url": [],
  "disponible": true
}

### 3. Crear pedido con dos detalles - 201 (total = 1 x 9500 + 2 x 3200 = 15900)
# @name pedido1
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{pizza.response.body.$.id}}, "cantidad": 1 },
    { "producto_id": {{cerveza.response.body.$.id}}, "cantidad": 2 }
  ]
}

### 4. Crear pedido con un detalle - 201 (total = 3 x 3200 = 9600)
# @name pedido2
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{cerveza.response.body.$.id}}, "cantidad": 3 }
  ]
}

### 5. Error 422: Crear pedido con la lista de detalles vacía (RN-12)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": []
}

### 6. Error 422: Crear pedido sin el campo detalles
POST {{baseUrl}}/pedidos
Content-Type: application/json

{}

### 7. Error 422: Crear pedido con cantidad 0 (< 1)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{pizza.response.body.$.id}}, "cantidad": 0 }
  ]
}

### 8. Error 422: Crear pedido con un mismo producto repetido (RN-12)
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{pizza.response.body.$.id}}, "cantidad": 1 },
    { "producto_id": {{pizza.response.body.$.id}}, "cantidad": 2 }
  ]
}

### 9. Error 404: Crear pedido con un producto inexistente (demuestra rollback en UoW)
# El primer detalle es válido: el pedido llega a insertarse con flush,
# pero al fallar el segundo detalle el Unit of Work revierte toda la transacción.
POST {{baseUrl}}/pedidos
Content-Type: application/json

{
  "detalles": [
    { "producto_id": {{pizza.response.body.$.id}}, "cantidad": 1 },
    { "producto_id": 999999, "cantidad": 1 }
  ]
}

### 10. Listar pedidos - 200 (el pedido fallido del caso 9 no figura)
GET {{baseUrl}}/pedidos

### 11. Detalle del pedido 1 con sus detalles - 200
GET {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}

### 12. Error 404: Detalle de un pedido inexistente (RN-13)
GET {{baseUrl}}/pedidos/999999

### 13. Error 422: Detalle con id 0 (Path gt=0)
GET {{baseUrl}}/pedidos/0

### 14. Cambiar el estado del pedido 1 a CONFIRMADO - 200
PUT {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}
Content-Type: application/json

{
  "estado": "CONFIRMADO"
}

### 15. Cambiar el estado del pedido 1 a ENTREGADO - 200
PUT {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}
Content-Type: application/json

{
  "estado": "ENTREGADO"
}

### 16. Error 422: Cambiar a un estado fuera de los permitidos
PUT {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}
Content-Type: application/json

{
  "estado": "EN_CAMINO"
}

### 17. Error 422: Cambiar a un estado en minúsculas
PUT {{baseUrl}}/pedidos/{{pedido1.response.body.$.id}}
Content-Type: application/json

{
  "estado": "pendiente"
}

### 18. Error 404: Cambiar el estado de un pedido inexistente (RN-13)
PUT {{baseUrl}}/pedidos/999999
Content-Type: application/json

{
  "estado": "CANCELADO"
}

### 19. Borrado lógico del pedido 2 - 204
DELETE {{baseUrl}}/pedidos/{{pedido2.response.body.$.id}}

### 20. Error 404: Ver el pedido 2 eliminado (RN-13)
GET {{baseUrl}}/pedidos/{{pedido2.response.body.$.id}}

### 21. Error 404: Cambiar el estado del pedido 2 eliminado (RN-13)
PUT {{baseUrl}}/pedidos/{{pedido2.response.body.$.id}}
Content-Type: application/json

{
  "estado": "CANCELADO"
}

### 22. Error 404: Eliminar otra vez el pedido 2 (RN-13)
DELETE {{baseUrl}}/pedidos/{{pedido2.response.body.$.id}}

### 23. Listar pedidos - 200 (el pedido 2 ya no aparece en el listado activo)
GET {{baseUrl}}/pedidos

### 24. Error 409: Eliminar un producto que figura en un pedido existente
# La pizza está en el pedido 1: la clave foránea impide borrarlo y el backend responde 409
DELETE {{baseUrl}}/productos/{{pizza.response.body.$.id}}
